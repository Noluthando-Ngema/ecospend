<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ecospend_bg"
    android:padding="24dp"
    tools:context=".landing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ECOSPEND"
            android:textColor="@color/ecospend_dark_green"
            android:textSize="18sp"
            android:textStyle="bold"
            />

    </LinearLayout>
    <!--code for the budget app badge-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@color/ecospend_badge_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="BUDGET TRACKING APP"
        android:textColor="@color/ecospend_dark_green"
        android:textSize="12sp"
        />
    <!-- app slogan-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="shota kabo kae\nko tlatse"
        android:textColor="@color/ecospend_dark_green"
        android:textSize="36sp"
        android:textStyle="bold"
        />
    <!-- app subtitle-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"
        android:text="Elevate your financial landscape through curated tracking and editorial-grade insight.\nDesigned for those who treat budgeting as a craft."
        android:textColor="@color/ecospend_gray_text"
        android:textSize="16sp"
        />
    <!-- app spacer-->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ecospend_jar"
        />
    <!-- register button-->
    <Button
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/ecospend_dark_green"
        android:text="Register"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:onClick="onRegisterClick"
        />
    <Button
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/white"
        android:text="Login"
        android:textColor="@color/ecospend_dark_green"
        android:textSize="16sp"
        android:textStyle="bold"
        android:onClick="onLoginClick"
        />

</LinearLayout>